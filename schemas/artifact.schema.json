{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory Artifact",
  "type": "object",
  "required": [
    "artifact_id",
    "type",
    "business_dna_version",
    "status",
    "risk",
    "source_refs",
    "approval_refs",
    "license_refs",
    "content_hash",
    "execution_version"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "type": {
      "enum": [
        "application-manifest",
        "module-generation",
        "data-model",
        "api-contract",
        "ui-contract",
        "admin-contract",
        "document-contract",
        "test-contract"
      ]
    },
    "business_dna_version": { "type": "string" },
    "status": {
      "enum": ["draft", "generated", "review", "approved", "released", "superseded"]
    },
    "risk": {
      "enum": ["low", "medium", "high", "critical"]
    },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "approval_refs": { "type": "array", "items": { "type": "string" } },
    "license_refs": { "type": "array", "items": { "type": "string" } },
    "content_hash": { "type": "string", "minLength": 64, "maxLength": 64 },
    "execution_version": { "type": "string" },
    "content": { "type": "object" }
  }
}
